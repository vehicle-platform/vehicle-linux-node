# Optional listen-only tap on the CL250 vehicle bus (%i, e.g. can1) for raw logging.
# vehicle-linux-node-can always sets listen-only on here (invariant 1).
[Unit]
Description=vehicle-platform vehicle bus listen-only tap on %i
After=sys-subsystem-net-devices-%i.device
BindsTo=sys-subsystem-net-devices-%i.device

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/vehicle-linux-node
ExecStart=%h/vehicle-linux-node/.venv/bin/vehicle-linux-node-can vehicle-tap %i
ExecStop=/usr/sbin/ip link set %i down

# Sandbox (B-11). ProtectHome=read-only, not yes: the checkout and venv live in $HOME.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# CAP_NET_ADMIN only here (ip link set); the installer adds User=, so the unit is not root (B-5).
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
RestrictAddressFamilies=AF_NETLINK AF_UNIX

[Install]
WantedBy=multi-user.target
