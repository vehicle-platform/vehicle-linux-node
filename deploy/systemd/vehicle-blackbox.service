# Event-based black-box recorder fed by the databroker (hardware-architecture §5b.8).
[Unit]
Description=vehicle-platform black-box recorder
After=vehicle-kuksa.service
Wants=vehicle-kuksa.service

[Service]
Type=simple
WorkingDirectory=%h/vehicle-linux-node
Environment=VEHICLE_BLACKBOX_DIR=%h/vehicle-data/blackbox
Environment=VEHICLE_KUKSA_ADDR=127.0.0.1:55555
ExecStart=%h/vehicle-linux-node/.venv/bin/vehicle-linux-node-blackbox run
Restart=on-failure
RestartSec=5

# Sandbox (B-11). ProtectHome=read-only, not yes: the checkout and venv live in $HOME.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
PrivateDevices=yes
RemoveIPC=yes
MemoryMax=512M
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=%h/vehicle-data
UMask=0077

[Install]
WantedBy=multi-user.target
