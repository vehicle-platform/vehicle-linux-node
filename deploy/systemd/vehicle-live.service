# Live telemetry uplink Kuksa -> MQTT 5 (D-109, provisional). NOT enabled by install.sh:
# configure ~/.config/vehicle-live.env first (see deploy/README.md).
[Unit]
Description=vehicle-platform live telemetry uplink (MQTT)
After=vehicle-kuksa.service network-online.target
Wants=vehicle-kuksa.service network-online.target

[Service]
Type=simple
WorkingDirectory=%h/vehicle-linux-node
Environment=VEHICLE_KUKSA_ADDR=127.0.0.1:55555
EnvironmentFile=-%h/.config/vehicle-live.env
ExecStart=%h/vehicle-linux-node/.venv/bin/vehicle-linux-node-live
Restart=on-failure
RestartSec=5
# exit 2 = missing/invalid configuration: do not restart-loop
RestartPreventExitStatus=2

# Sandbox (B-11). ProtectHome=read-only, not yes: the checkout and venv live in $HOME.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
PrivateDevices=yes
RemoveIPC=yes
MemoryMax=512M
CapabilityBoundingSet=
# No AF_CAN: applications never touch SocketCAN.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
